{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/public",
  "framework": "vite",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/plans/growth-system",
      "destination": "/plans/complete-system",
      "permanent": true
    },
    {
      "source": "/plans/complete-pack",
      "destination": "/plans/complete-system",
      "permanent": true
    },
    {
      "source": "/plans/local-seo-pack",
      "destination": "/plans/complete-system",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/book",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
